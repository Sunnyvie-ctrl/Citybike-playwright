{
  "name": "citybike-playwright-qa-lab",
  "version": "1.0.0",
  "private": true,
  "description": "3-hour DevOps lab: Playwright end-to-end tests and GitHub Actions quality gate",
  "scripts": {
    "start": "node server.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "report": "playwright show-report",
    "check:files": "node scripts/check-environment.cjs",
    "check:api": "node scripts/verify-api.cjs",
    "test:e2e:smoke": "playwright test tests/01-smoke.spec.js"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  },
  "engines": {
    "node": ">=22 <27"
  }
}
